# Contact form API URL (frontend -> backend)
# Leave unset to use /api/contact (relative). Set when frontend and server run on different origins:
# VITE_CONTACT_API_URL=http://localhost:4000/api/contact

# --- Gmail SMTP (see README "Gmail SMTP setup" for how to get App Password) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_FROM=yourname@gmail.com
# SMTP_TO=yourname@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
